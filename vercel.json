{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api"
    },
    {
      "src": "/robots.txt",
      "dest": "/api"
    },
    {
      "src": "/",
      "dest": "/api"
    },
    {
      "src": "/provider/(.*)",
      "dest": "/api"
    },
    {
      "src": "/gemach/(.*)",
      "dest": "/api"
    },
    {
      "src": "/company/(.*)",
      "dest": "/api"
    },
    {
      "src": "/directory(/.*)?",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
