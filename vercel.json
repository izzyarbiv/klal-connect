{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Content-Security-Policy-Report-Only": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.public.blob.vercel-storage.com https://*.googleusercontent.com https://*.tile.openstreetmap.org https://maps.googleapis.com https://maps.gstatic.com https://*.ggpht.com; script-src 'self' 'sha256-DNsj5vrPQNdXzy+xfn0j8t2mIzyIwAopJJt3ZePGK1k=' https://accounts.google.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://accounts.google.com https://maps.googleapis.com https://*.public.blob.vercel-storage.com https://nominatim.openstreetmap.org; frame-src https://accounts.google.com; worker-src 'self'"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/brand/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "/(sw\\.js|workbox-.*\\.js|manifest\\.webmanifest)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api"
    },
    {
      "src": "/robots.txt",
      "dest": "/api"
    },
    {
      "src": "/",
      "dest": "/api"
    },
    {
      "src": "/provider/(.*)",
      "dest": "/api"
    },
    {
      "src": "/gemach/(.*)",
      "dest": "/api"
    },
    {
      "src": "/company/(.*)",
      "dest": "/api"
    },
    {
      "src": "/directory(/.*)?",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/feed(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/people(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/messages(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/saved(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/profile(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/settings(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/admin(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/welcome(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/login(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/register(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/forgot-password(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/reset-password(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/join(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/browse(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/companies(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/create-company(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/add(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/privacy(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ]
}
