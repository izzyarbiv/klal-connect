# Klal — API server
# Copy to .env.local and fill in. Nothing here is required for local dev.

# Secret used to sign session tokens. REQUIRED in production; the server
# refuses to boot with the dev default when NODE_ENV=production.
KC_JWT_SECRET=

# Port the API listens on (default 4000).
KC_PORT=4000

# Where the dev web server proxies /api (default http://localhost:4000).
KC_API_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
# Postgres connection string. On Supabase use the TRANSACTION POOLER URL
# (port 6543), not the direct connection (5432): a serverless deployment opens
# far more short-lived connections than Postgres accepts directly.
DATABASE_URL=

# --- File uploads ----------------------------------------------------------
# With both set, uploads go to Supabase Storage. Without them they are written
# to server/uploads, which is fine locally but loses every file on a serverless
# host. The service role key bypasses row-level security — server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# Local-disk directory, used only when the Supabase vars above are unset.
KC_UPLOAD_DIR=

# Set to "real" once an email provider is wired up. Until then, signup and
# password-reset codes are logged to the server console and returned to the
# client so you can complete the flow locally.
KC_EMAIL_DELIVERY=dev

# --- Geocoding -------------------------------------------------------------
# OpenStreetMap's Nominatim is the default but is NOT usable in production: it
# returns 403 for traffic it cannot attribute to a registered application, and
# its policy forbids the volume a live app produces. Pick a real provider.
#   mapbox     https://account.mapbox.com   (100k free req/mo)
#   google     https://console.cloud.google.com — Geocoding API (10k free/mo)
#   geoapify   https://myprojects.geoapify.com (3k/day free)
#   locationiq https://locationiq.com       (5k/day free)
KC_GEOCODER=nominatim
KC_GEOCODER_KEY=
# Contact address sent to Nominatim per its policy. Ignored by other providers.
KC_GEOCODER_CONTACT=

# --- Map -------------------------------------------------------------------
# With a key, the directory map is Google Maps. This key is sent to the browser
# by design: in the Cloud console restrict it to this site's referrers and to
# the Maps JavaScript API only, and use a SEPARATE key for KC_GEOCODER_KEY.
# Read at runtime — no rebuild.
GOOGLE_MAPS_BROWSER_KEY=
# Optional: a Map ID from Cloud console → Map Management, for custom styling.
GOOGLE_MAPS_MAP_ID=

# Without a Google key the map falls back to Leaflet with these tiles. OSM's
# tile policy does not cover production app traffic.
KC_TILE_URL=
KC_TILE_ATTRIBUTION=

# IP geolocation endpoint used only when browser geolocation is denied.
# {ip} is substituted with the caller's address.
KC_IPGEO_URL=

# Set to 1 when running behind a proxy/CDN that sets X-Forwarded-For (Vercel,
# nginx). Leave unset otherwise, or clients can spoof their own IP.
KC_TRUST_PROXY=
