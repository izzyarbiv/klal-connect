# Klal Connect — API server
# Copy to .env.local and fill in. Nothing here is required for local dev.

# Secret used to sign session tokens. REQUIRED in production; the server
# refuses to boot with the dev default when NODE_ENV=production.
KC_JWT_SECRET=

# Port the API listens on (default 4000).
KC_PORT=4000

# Where the dev web server proxies /api (default http://localhost:4000).
KC_API_URL=http://localhost:4000

# Where SQLite and uploaded files live (defaults to server/data and server/uploads).
KC_DATA_DIR=
KC_UPLOAD_DIR=

# Set to "real" once an email provider is wired up. Until then, signup and
# password-reset codes are logged to the server console and returned to the
# client so you can complete the flow locally.
KC_EMAIL_DELIVERY=dev

# --- Geocoding -------------------------------------------------------------
# OpenStreetMap's Nominatim is the default but is NOT usable in production: it
# returns 403 for traffic it cannot attribute to a registered application, and
# its policy forbids the volume a live app produces. Pick a real provider.
#   mapbox     https://account.mapbox.com   (100k free req/mo)
#   geoapify   https://myprojects.geoapify.com (3k/day free)
#   locationiq https://locationiq.com       (5k/day free)
KC_GEOCODER=nominatim
KC_GEOCODER_KEY=
# Contact address sent to Nominatim per its policy. Ignored by other providers.
KC_GEOCODER_CONTACT=

# Map tiles. OSM's tile policy also does not cover production app traffic, so
# point this at a paid tile provider before launch. Read at runtime — no rebuild.
KC_TILE_URL=
KC_TILE_ATTRIBUTION=

# IP geolocation endpoint used only when browser geolocation is denied.
# {ip} is substituted with the caller's address.
KC_IPGEO_URL=

# Set to 1 when running behind a proxy/CDN that sets X-Forwarded-For (Vercel,
# nginx). Leave unset otherwise, or clients can spoof their own IP.
KC_TRUST_PROXY=
